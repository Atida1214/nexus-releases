{
  "name": "nexus-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "NEXUS independent knowledge and browser app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.nexus.browser",
    "productName": "NEXUS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "manifest.webmanifest",
      "sw.js",
      "icon-192.png",
      "icon-512.png",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Atida1214",
        "repo": "nexus-releases",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}